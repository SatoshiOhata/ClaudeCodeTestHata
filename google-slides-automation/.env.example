# Google Cloud OAuth 2.0 認証情報
# Google Cloud Console (https://console.cloud.google.com/) で取得してください
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REFRESH_TOKEN=your-refresh-token

# Zendesk テンプレート設定
# Google Slides テンプレートの Presentation ID
# URL例: https://docs.google.com/presentation/d/<PRESENTATION_ID>/edit
ZENDESK_TEMPLATE_ID=your-template-presentation-id

# 生成されたスライドの保存先フォルダ（Google Drive Folder ID）
OUTPUT_FOLDER_ID=your-drive-folder-id
